{
  "permissions": {
    "defaultMode": "bypassPermissions",
    "deny": [
      "Bash(gh api *statuses*)",
      "Bash(git add -f *)",
      "Bash(git add --force *)",
      "Bash(gh ruleset *)",
      "Bash(gh api *rulesets*)",
      "Bash(gh api *branches*protection*)",
      "Bash(gh repo edit *)",
      "Bash(git commit --amend *)",
      "Bash(git rebase *)",
      "Bash(git tag *)"
    ]
  },
  "crossSessionInbound": "accept"
}
