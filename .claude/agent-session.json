{
  "permissions": {
    "defaultMode": "bypassPermissions",
    "deny": [
      "Bash(gh api *statuses*)",
      "Bash(git add -f *)",
      "Bash(git add --force *)",
      "Bash(gh ruleset *)",
      "Bash(gh api *rulesets*)",
      "Bash(gh api *branches*protection*)",
      "Bash(gh repo edit *)",
      "Bash(git commit --amend *)",
      "Bash(git rebase *)",
      "Bash(git tag *)",
      "Bash(* --no-verify*)",
      "Bash(git push *--force*)",
      "Bash(git push -f*)",
      "Bash(git push * -f *)",
      "Bash(git config *)",
      "Bash(gh auth token*)",
      "Bash(git branch -D *)",
      "Bash(git push * --delete *)"
    ]
  },
  "crossSessionInbound": "accept"
}
