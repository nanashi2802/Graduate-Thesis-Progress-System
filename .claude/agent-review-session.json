{
  "permissions": {
    "defaultMode": "bypassPermissions",
    "deny": [
      "Edit",
      "Write",
      "NotebookEdit",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git merge *)",
      "Bash(git add *)",
      "Bash(gh pr merge *)",
      "Bash(gh pr create *)",
      "Bash(gh pr close *)",
      "Bash(gh ruleset *)",
      "Bash(gh api *rulesets*)",
      "Bash(gh api *branches*protection*)",
      "Bash(gh repo edit *)",
      "Bash(vercel *)",
      "Bash(git commit --amend *)",
      "Bash(git rebase *)",
      "Bash(git tag *)",
      "Bash(* --no-verify*)",
      "Bash(git push *--force*)",
      "Bash(git push -f*)",
      "Bash(git push * -f *)",
      "Bash(git config *)",
      "Bash(gh auth token*)",
      "Bash(git branch -D *)",
      "Bash(git push * --delete *)"
    ]
  },
  "crossSessionInbound": "accept"
}
