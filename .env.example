# Copy this file to .env.local and fill in the values.
# Never commit .env.local or any real value (AGENTS.md ยง11).
# How to get each value: see the setup steps for P0 (Neon, Resend, Vercel).

# --- App ---
# Base URL for links in emails (FR-NTF-02). Local: http://localhost:3000
APP_URL=http://localhost:3000

# --- Neon Postgres (project ThesIsko) ---
# Pooled connection for the app.
DATABASE_URL=
# Direct connection for migrations.
DATABASE_URL_UNPOOLED=

# --- Neon Auth (FR-ACC-01) ---
# Not secret. From the Neon console: branch main > Auth > Configuration (Auth URL).
NEON_AUTH_BASE_URL=
# Secret. You make it yourself, 32 characters or more: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=

# Development only. The password of the fake users from `pnpm db:seed-dev` (P0-E03, AD-A-006).
# Never set it in Vercel.
DEV_SEED_PASSWORD=

# --- Neon Object Storage (NFR-12). One private bucket for all files. ---
S3_ENDPOINT=
S3_REGION=ap-southeast-1
S3_BUCKET=thesis-files
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Key prefix for test files (AGENTS.md ง13.8): agent-a or agent-b in a worktree. Empty in Vercel.
FILE_KEY_PREFIX=

# --- Resend (FR-NTF-02 to 09) ---
RESEND_API_KEY=
# Without your own domain, Resend sends only from this address to your own email.
EMAIL_FROM=onboarding@resend.dev
# Optional. When set, the daily job sends one test email to this address (P0-E05, AD-B-004).
# With onboarding@resend.dev, use the email of the Resend account owner.
NOTIFY_TEST_TO=

# --- Vercel Cron (FR-NTF-06) ---
# Random string. Vercel sends it to the cron route. Make one with: openssl rand -hex 32
CRON_SECRET=
